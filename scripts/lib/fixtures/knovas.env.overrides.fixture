# A deployment that needs more than the five orchestration values: plain HTTP,
# so the session cookie must not be Secure, plus a Cortex fixture and one RC key.
KNOVAS_API_URL=https://api.test:8443
KNOVAS_PLATFORM_URL=http://localhost:8081
KNOVAS_DOCUMENTS_PATH=/mnt/share/pilot
PLATFORM_ADMIN_EMAIL=admin@test.internal
KNOVAS_TENANT_ID=11111111-1111-1111-1111-111111111111
WEB_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENVIRONMENT=local
WEB_SESSION_COOKIE_SECURE=false
ONTOLOGY_FIXTURE_PATH=/mnt/ontology/ontology_fixture.json
DOCBRIDGE_WEB_PORT=18081
RC_SYNC_AUTO_START_CONTINUOUS=false
