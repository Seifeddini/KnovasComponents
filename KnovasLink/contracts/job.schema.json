{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knovas.ch/connector/v1.1/job.schema.json",
  "title": "Job on the work channel (connector protocol 1.1)",
  "description": "A job Knovas queues for a site and Knovas Link hands to a component. The job object is open: a component ignores fields it does not know. Its actor and its args are closed: the actor is recorded as declared, and args are instructions, so one a component does not know is never ignored.",
  "type": "object",
  "required": ["id", "kind", "deadline", "actor", "args"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "kind": {"type": "string", "enum": ["fetch", "write", "probe"]},
    "source": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "The workspace source key the job is for; null for a probe."
    },
    "target_serial": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "The certificate serial a probe is addressed to; null otherwise."
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 in UTC, with Z or +00:00. After it the job has an outcome without the component.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]{1,9})?(Z|\\+00:00)$"
    },
    "actor": {"$ref": "#/$defs/actor"},
    "args": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "fetch"}}, "required": ["kind"]},
      "then": {"properties": {"args": {"$ref": "#/$defs/fetch_args"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "write"}}, "required": ["kind"]},
      "then": {"properties": {"args": {"$ref": "#/$defs/write_args"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "probe"}}, "required": ["kind"]},
      "then": {"properties": {"args": {"$ref": "#/$defs/probe_args"}}}
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "description": "Who asked, as the caller declares it: recorded, never trusted for a decision. Closed.",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["user", "agent", "component", "system"]},
        "id": {"type": "string", "minLength": 1},
        "on_behalf_of": {
          "type": ["object", "null"],
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "fetch_args": {
      "type": "object",
      "description": "Read the original bytes of one item. Closed.",
      "required": ["external_id", "max_bytes"],
      "additionalProperties": false,
      "properties": {
        "external_id": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "The version to read; absent means the source's current one."
        },
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 26214400}
      }
    },
    "write_args": {
      "type": "object",
      "description": "Stage a change of facts in the source, where the source reviews it. Closed.",
      "required": ["mapping", "node_key", "external_id", "expected_version", "facts", "mode"],
      "additionalProperties": false,
      "properties": {
        "mapping": {"type": "string", "minLength": 1},
        "node_key": {"type": "string", "minLength": 1},
        "external_id": {"type": "string", "minLength": 1},
        "expected_version": {"type": "string", "minLength": 1},
        "facts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        },
        "mode": {"const": "proposal"}
      }
    },
    "probe_args": {
      "type": "object",
      "description": "No arguments. Closed.",
      "additionalProperties": false
    }
  }
}
