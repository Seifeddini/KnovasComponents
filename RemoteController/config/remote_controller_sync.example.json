{
  "schema_version": 1,
  "enabled": true,
  "mode": "continuous",
  "window": {
    "start_local": "00:00",
    "end_local": "23:59"
  },
  "rate_limit": {
    "max_ingestion_chars_per_minute": 180000,
    "burst_chars": 50000,
    "max_ingestion_requests_per_minute": 30,
    "burst": 5
  },
  "pause_policy": "finish_current_unit_then_pause",
  "scan_interval_seconds": 60,
  "max_files_per_cycle": 500,
  "max_scan_entries_per_cycle": 10000,
  "sequential_subfolders": false
}