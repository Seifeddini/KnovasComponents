{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "scheduler_status",
    "files_scanned",
    "files_uploaded",
    "files_skipped",
    "ingestion_requests_sent",
    "transmissions",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string" },
    "scheduler_status": { "type": "string" },
    "files_scanned": { "type": "integer", "minimum": 0 },
    "files_uploaded": { "type": "integer", "minimum": 0 },
    "files_skipped": { "type": "integer", "minimum": 0 },
    "ingestion_requests_sent": { "type": "integer", "minimum": 0 },
    "paused_reason": { "type": ["string", "null"] },
    "transmissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status"],
        "additionalProperties": true,
        "description": "One upload of this run. When the init carried Knovas document fields, the entry also has `fields`: {outcome, staged, warning_codes} -- codes and counts only, never values.",
        "properties": {
          "path": { "type": "string" },
          "transmission_key_id": { "type": "string" },
          "parts": { "type": "integer", "minimum": 0 },
          "status": { "type": "string" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "error"],
        "properties": {
          "path": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    },
    "transmissions_truncated": { "type": "boolean" },
    "document_sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "synced": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "modified": { "type": "integer", "minimum": 0 },
        "excluded_max_age": { "type": "integer", "minimum": 0 },
        "fields_changed": { "type": "integer", "minimum": 0 }
      }
    },
    "doc_fields": {
      "type": "object",
      "description": "Knovas document-fields summary of this run (outcome counts, refusal and warning codes, client-side drops). Keys and codes only, never values."
    }
  }
}
