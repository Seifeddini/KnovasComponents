# Required — fail fast on boot if missing
KNOVAS_INTERNAL_API_URL=http://internal-api:5000
RC_INSTANCE_TOKEN=change-me-from-knovas-admin
RC_CLIENT_ID=00000000-0000-0000-0000-000000000001
RC_WATCH_ROOTS=/data/docs
SEMANTIX_SECURE_BASE_URL=https://nginx:8443
SEMANTIX_CLIENT_CERT_PATH=/certs/client-cert.pem
SEMANTIX_CLIENT_KEY_PATH=/certs/client-key.pem
SEMANTIX_CA_CERT_PATH=/certs/ca-root.pem

# mTLS certificate auto-renew (CSR signing via /secured/sign_certificate)
# SEMANTIX_CERT_AUTO_RENEW_ENABLED=true
# SEMANTIX_CERT_RENEW_METHOD=csr
# SEMANTIX_CERT_RENEW_THRESHOLD_DAYS=30
# SEMANTIX_CERT_CHECK_INTERVAL_SECONDS=3600

# API
RC_API_PORT=5001

# GI-RC-02 rate limits
RC_RATE_LIMIT_ENABLED=true
RC_RATE_LIMIT_IP_MAX_TOKENS=30
RC_RATE_LIMIT_IP_REFILL_PER_SEC=0.5
RC_RATE_LIMIT_HANDLED_MAX_TOKENS=10
RC_RATE_LIMIT_HANDLED_REFILL_PER_SEC=0.2

# Knovas verify
KNOVAS_VERIFY_CACHE_TTL_SECONDS=45
RC_VERIFY_TIMEOUT_SECONDS=10

# --- Local development (localhost only) ---
# Follow docs/local-setup.md. Start with:
#   docker compose -f docker-compose.yml -f docker-compose.internal.yml up -d --build
# Recommended with internal compose (RC_INTERNAL_LOCAL_BYPASS is set there):
#   RC_WATCH_ROOTS=/data/docs
#   RC_SYNC_DEFAULT_WINDOW_START=00:00
#   RC_SYNC_DEFAULT_WINDOW_END=23:59
# RC_INSTANCE_TOKEN can be empty when bypass is on.

# Dev/test only — never enable in production
# RC_SKIP_CONFIG_VALIDATION=true  # skips required-env check at boot (pytest only)
# RC_INTERNAL_LOCAL_BYPASS=true   # discover + sync on localhost without RC_INSTANCE_TOKEN or JWT
# RC_DISCOVER_LOCAL_BYPASS=true   # alias for RC_INTERNAL_LOCAL_BYPASS
# RC_LOCAL_BYPASS_TRUSTED_CIDRS=172.16.0.0/12  # extra source ranges (comma-separated)
#   allowed to use the local bypass; loopback is always allowed. The internal
#   compose overlay sets this to the Docker bridge range so host-local requests
#   via 127.0.0.1:5001 pass the check despite Docker source-NAT.

# OneDrive mirror (optional — when set, RC runs an in-process background
# thread that mirrors a OneDrive folder to ONEDRIVE_MIRROR_PATH using
# Microsoft Graph application client credentials. Point RC_WATCH_ROOTS at
# the mirror path so discover/sync picks it up.
#
# Required (all four) to enable:
#   ONEDRIVE_DRIVE_ID, ONEDRIVE_TENANT_ID, ONEDRIVE_CLIENT_ID, ONEDRIVE_CLIENT_SECRET
# The Azure AD app must have Microsoft Graph application permission
# `Files.Read.All` with admin consent in the target tenant.
# ONEDRIVE_DRIVE_ID=
# ONEDRIVE_ROOT_PATH=/SharePointRoot
# ONEDRIVE_TENANT_ID=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# ONEDRIVE_MAX_FILE_SIZE_MB=50
# ONEDRIVE_ALLOWED_EXTENSIONS=pdf,docx,txt,md,eml,msg
# ONEDRIVE_MIRROR_PATH=/data/onedrive_mirror
# ONEDRIVE_MIRROR_INTERVAL_SECONDS=300
# Optional — when set, writes a JSONL of {doc_id, web_url, title, modified_at}
# that KnovasPlatform docbridge-web can read via SEARCH_ENRICHMENT_PATH to
# render an "Open in OneDrive" button. ONEDRIVE_IDENTIFIER_PREFIX must match
# the ingestion.identifier_prefix used in your RC /sync request body.
# ONEDRIVE_IDENTIFIER_PREFIX=tenant
# ONEDRIVE_SEARCH_ENRICHMENT_PATH=/mirror/.search_enrichment.jsonl
# Optional — per-document sentence index for search previews (first page + match context).
# Must be readable by docbridge-web (SEARCH_CONTEXT_STORE_PATH) and writable by RC sync.
# SEARCH_CONTEXT_STORE_PATH=/mirror/.search_context
# Set to false to disable the Microsoft Graph delta fast path; the mirror then
# always walks the entire drive tree (slow). Default true. The mirror auto-
# falls back to a full walk if a saved delta token is rejected by Graph.
# ONEDRIVE_MIRROR_USE_DELTA=true

# Sync scheduler
RC_SYNC_CONFIG_PATH=config/remote_controller_sync.json
RC_SYNC_CONFIG_API_ENABLED=false
RC_SYNC_AUTO_START_CONTINUOUS=false
RC_SYNC_AUTO_START_REQUIRES_SAVED_BODY=true
RC_TIMEZONE=
RC_SYNC_STATE_PATH=.rc-sync-state.json
RC_SYNC_DEFAULT_MODE=continuous
RC_SYNC_DEFAULT_WINDOW_START=00:00
RC_SYNC_DEFAULT_WINDOW_END=23:59
RC_SYNC_DEFAULT_MAX_INGESTION_REQUESTS_PER_MINUTE=3
RC_SYNC_DEFAULT_BURST=1
RC_SYNC_DEFAULT_SCAN_INTERVAL_SECONDS=60
