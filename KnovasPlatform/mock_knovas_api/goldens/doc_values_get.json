{
  "name": "doc_values_get",
  "description": "GET doc-values with the pointer in the JSON body, so it stays out of the request line. fields holds each field's effective value, layers every stored row (here the upload layer). version is opaque: send back what you read (a first stored upload leaves 4 today).",
  "server_state": "values",
  "setup": [
    {
      "method": "POST",
      "path": "/secured/init_document_transmission",
      "body": {
        "identifier": "rc-sync/Muster AG/GJ 2024/Rechnung_17.pdf",
        "part_count": 1,
        "title": "Rechnung_17.pdf",
        "path": "Muster AG/GJ 2024/Rechnung_17.pdf",
        "fields": {
          "doc_type": "invoice",
          "period": "GJ 2024",
          "amount": "CHF 1'234.50"
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/secured/graph/doc-values",
    "body": {
      "pointer": "rc-sync/Muster AG/GJ 2024/Rechnung_17.pdf"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "status": "success",
      "message": "Document values",
      "pointer": "rc-sync/Muster AG/GJ 2024/Rechnung_17.pdf",
      "acl_mode": "follows_document",
      "version": 4,
      "title": "Rechnung_17.pdf",
      "title_source": "upload",
      "description": null,
      "path": "Muster AG/GJ 2024/Rechnung_17.pdf",
      "warnings": [],
      "fields": {
        "amount": {
          "amount": "1234.50",
          "currency": "CHF"
        },
        "doc_type": "invoice",
        "period": {
          "lo": "2024-01-01",
          "hi": "2024-12-31",
          "label": "2024"
        }
      },
      "layers": {
        "amount": [
          {
            "layer": "upload",
            "value": {
              "amount": "1234.50",
              "currency": "CHF"
            },
            "verified": false,
            "effective": true
          }
        ],
        "doc_type": [
          {
            "layer": "upload",
            "value": "invoice",
            "verified": false,
            "effective": true
          }
        ],
        "period": [
          {
            "layer": "upload",
            "value": {
              "lo": "2024-01-01",
              "hi": "2024-12-31",
              "label": "2024"
            },
            "verified": false,
            "effective": true
          }
        ]
      }
    }
  },
  "volatile": [
    "document_uuid",
    "ingested_at",
    "layers.amount.*.created_at",
    "layers.amount.*.source_ref",
    "layers.doc_type.*.created_at",
    "layers.doc_type.*.source_ref",
    "layers.period.*.created_at",
    "layers.period.*.source_ref"
  ],
  "absent": []
}
