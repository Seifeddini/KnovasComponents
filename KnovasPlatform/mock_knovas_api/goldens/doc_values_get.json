{
  "name": "doc_values_get",
  "description": "GET doc-values with the pointer in the JSON body.",
  "server_state": "values",
  "setup": [
    {
      "method": "POST",
      "path": "/secured/init_document_transmission",
      "body": {
        "identifier": "rc-sync/Muster AG/GJ 2024/Rechnung_17.pdf",
        "part_count": 1,
        "title": "Rechnung_17.pdf",
        "path": "Muster AG/GJ 2024/Rechnung_17.pdf",
        "fields": {
          "doc_type": "invoice",
          "period": "GJ 2024"
        }
      }
    }
  ],
  "request": {
    "method": "GET",
    "path": "/secured/graph/doc-values",
    "body": {
      "pointer": "rc-sync/Muster AG/GJ 2024/Rechnung_17.pdf"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "status": "success",
      "message": "Document values",
      "pointer": "rc-sync/Muster AG/GJ 2024/Rechnung_17.pdf",
      "acl_mode": "follows_document",
      "version": 1,
      "title": "Rechnung_17.pdf",
      "title_source": "upload",
      "path": "Muster AG/GJ 2024/Rechnung_17.pdf",
      "description": null,
      "fields": {
        "doc_type": "invoice",
        "period": "GJ 2024"
      },
      "layers": {
        "doc_type": [
          {
            "layer": "upload",
            "value": "invoice",
            "verified": false,
            "effective": true
          }
        ]
      }
    }
  },
  "volatile": [
    "document_uuid",
    "ingested_at",
    "layers.doc_type.*.created_at",
    "layers.doc_type.*.source_ref"
  ],
  "absent": []
}
