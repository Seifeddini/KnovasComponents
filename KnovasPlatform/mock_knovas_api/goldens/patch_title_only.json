{
  "name": "patch_title_only",
  "description": "A PATCH of the title only, with the version a GET returned: the answer carries every effective field value, not only the keys the PATCH named.",
  "server_state": "values",
  "setup": [
    {
      "method": "POST",
      "path": "/secured/init_document_transmission",
      "body": {
        "identifier": "rc-sync/Muster AG/GJ 2024/Rechnung_17.pdf",
        "part_count": 1,
        "title": "Rechnung_17.pdf",
        "path": "Muster AG/GJ 2024/Rechnung_17.pdf",
        "fields": {
          "doc_type": "invoice",
          "period": "GJ 2024",
          "amount": "CHF 1'234.50"
        }
      }
    }
  ],
  "request": {
    "method": "PATCH",
    "path": "/secured/graph/doc-values",
    "body": {
      "pointer": "rc-sync/Muster AG/GJ 2024/Rechnung_17.pdf",
      "if_version": 4,
      "set": {
        "title": "Rechnung Muster AG"
      }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "status": "success",
      "message": "Document values updated",
      "pointer": "rc-sync/Muster AG/GJ 2024/Rechnung_17.pdf",
      "version": 5,
      "title": "Rechnung Muster AG",
      "title_source": "manual",
      "description": null,
      "fields": {
        "amount": {
          "amount": "1234.50",
          "currency": "CHF"
        },
        "doc_type": "invoice",
        "period": {
          "lo": "2024-01-01",
          "hi": "2024-12-31",
          "label": "2024"
        }
      },
      "warnings": []
    }
  },
  "volatile": [],
  "absent": []
}
