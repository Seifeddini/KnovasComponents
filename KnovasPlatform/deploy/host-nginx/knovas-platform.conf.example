# Host nginx: TLS termination for Knovas Platform (Docker on 127.0.0.1:8081).
#
# With a public name and Let's Encrypt, ./scripts/host-https.sh <fqdn> <email>
# does all of the following. By hand (internal PKI):
# 1. Copy knovas-login-limit.conf to /etc/nginx/conf.d/ (the login throttle's zone
#    and the knovas_privacy access-log format this file uses).
# 2. Copy this file to /etc/nginx/sites-available/knovas.
# 3. Replace server_name and ssl_certificate* paths with your own.
# 4. If DOCBRIDGE_WEB_PORT in knovas.env is not 8081, change both proxy_pass lines.
# 5. sudo ln -s /etc/nginx/sites-available/knovas /etc/nginx/sites-enabled/
# 6. sudo nginx -t && sudo systemctl reload nginx
#
# Guide: docs/deployment/host-nginx-internal.md

server {
    listen 80;
    server_name knovas.example.internal;
    server_tokens off;
    # No request URI in the access log (format in knovas-login-limit.conf).
    access_log /var/log/nginx/access.log knovas_privacy;

    # Let's Encrypt issuance and renewal (scripts/host-https.sh); harmless otherwise.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name knovas.example.internal;
    server_tokens off;
    # Replaces the http-level "combined" log, whose "$request" is the URI with
    # its query string: Platform URLs carry document pointers. The format is
    # defined once per host in knovas-login-limit.conf (http context).
    access_log /var/log/nginx/access.log knovas_privacy;

    ssl_certificate     /etc/ssl/certs/knovas.example.internal-fullchain.pem;
    ssl_certificate_key /etc/ssl/private/knovas.example.internal.key;

    # TLS hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Security response headers (apply to every response, incl. proxied/errors).
    # HSTS is safe here because this vhost is TLS-only (the :80 block 301-redirects).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # SAMEORIGIN statt DENY: die App bettet eigene Dokumentvorschauen als
    # <iframe> ein. Framing durch fremde Herkuenfte bleibt verboten.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 32m;

    # X-Forwarded-For is SET, not appended to: the Platform records the first
    # address in it as the person's IP, and $proxy_add_x_forwarded_for would
    # keep whatever the browser sent there -- any client could name its own.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    # At least gunicorn's --timeout (DOCBRIDGE_WEB_TIMEOUT, default 180 s):
    # an admin upload may extract until its 120 s ceiling and must still
    # get its answer through, not a 504.
    proxy_read_timeout 180s;
    proxy_connect_timeout 10s;

    # Password guessing is throttled per client address here, in front of the
    # app: the app locks an account after repeated failures, which anyone who
    # knows an address could otherwise use to keep that person locked out.
    location = /login {
        limit_req zone=knovas_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8081;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
    }
}
