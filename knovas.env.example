# Knovas unified configuration — copy to knovas.env and fill required values.
# Run: ./scripts/setup.sh && ./scripts/start.sh

# Required
KNOVAS_API_URL=https://api.knovas.ch:8443
KNOVAS_PLATFORM_URL=https://knovas.example.internal
# Host path of the documents. Demo-Kanzlei: /home/master/corpus/kanzlei
# (see docs/demo-kanzlei-setup.md). Mounted as /mnt/documents and /mnt/autodoc.
KNOVAS_DOCUMENTS_PATH=/mnt/share/pilot

# The firm's first administrator. There is no default account: on first start
# the Platform creates this one and writes a one-time password to
# /run/platform-admin-bootstrap inside the docbridge-web container. Read it with
#   docker compose exec docbridge-web cat /run/platform-admin-bootstrap
# then sign in, change it, and delete the file.
PLATFORM_ADMIN_EMAIL=

# Per-user identity. **On by default.** The Platform signs each user into its
# Knovas calls with a key kept in PLATFORM_BROKER_KEY_DIR -- a persistent
# volume, backed up; see docs/certificates.md.
#
# Set IDENTITY_ENABLED=false only to stage a cutover on an existing deployment
# that still has COMPANY_LOGIN_* set: the Platform refuses to start with both
# the shared credential and per-user accounts configured, so an upgrade cannot
# quietly leave the old door open.
# IDENTITY_ENABLED=true
# PLATFORM_BROKER_KEY_DIR=/app/secrets/broker
#
# The console reaches the firm's RemoteController here (knovas-internal only).
# RC_BASE_URL=http://remote-controller:5001

# Anything else you put in this file is passed straight through to the component
# it names: RC_* reaches RemoteController, everything else reaches the Platform,
# and it overrides the generated default. The generated .env files are rewritten
# on every setup.sh, so this is the place for a setting they do not cover:
#
#   # Plain HTTP (no TLS in front): a Secure cookie is dropped by the browser
#   # and the session never sticks, so login silently bounces back to the form.
#   WEB_SESSION_COOKIE_SECURE=false
#
#   # Cortex data source. 'graph' is the real thing: types, entities and links
#   # live in the tenant's Knowledge Graph over mTLS, so they persist because
#   # Knovas stores them and the local fixture is not used at all. Requires the
#   # Knowledge Graph to be enabled for the tenant -- ./scripts/doctor.sh says
#   # whether it is. Type-LEVEL relations ("Mandanten haben Dossiers") are
#   # refused in this mode by design; entity-level relations work.
#   ONTOLOGY_SOURCE=graph
#
#   # 'fixture' is the offline demo: a local JSON file, mounted writable at
#   # /mnt/ontology by docker-compose.yml. Without the path set, edits are kept
#   # in memory and vanish on the next reload.
#   ONTOLOGY_SOURCE=fixture
#   ONTOLOGY_FIXTURE_PATH=/mnt/ontology/ontology_fixture.json
#
#   # Where the per-document sidecars holding the search-result text live.
#   # /secured/query returns match locations without chunk text, so with no
#   # store every result renders as a title with nothing under it -- and no
#   # error, because a missing store is treated as "no context available".
#   # Ingestion writes these; the default is the volume RemoteController fills.
#   # An existing store from an earlier deployment can be read instead:
#   SEARCH_CONTEXT_STORE_PATH=/mnt/autodoc/preview_storage

# Where the web UI is published. The default binds localhost only, so a reverse
# proxy on the host is the way in and nothing reaches the app directly. Set
# 0.0.0.0 to publish on the LAN -- and then set WEB_SESSION_COOKIE_SECURE=false
# above, or the browser drops the session cookie over plain HTTP. On the LAN
# without TLS, passwords and session cookies travel in the clear.
# DOCBRIDGE_WEB_BIND=127.0.0.1
# DOCBRIDGE_WEB_PORT=8081

# An account locks after this many failed sign-ins, for this long. 0 attempts
# switches locking off -- reasonable on a trusted LAN where a locked-out
# colleague costs more than the protection buys, but then an online password
# guess is bounded only by the per-IP throttle. Failures are still counted
# either way, so turning it back on takes effect immediately.
# IDENTITY_ACCOUNT_LOCKOUT_ATTEMPTS=5
# IDENTITY_ACCOUNT_LOCKOUT_MINUTES=15

# Optional (setup.sh fills defaults when empty)
# KNOVAS_TENANT_ID=
# KNOVAS_IDENTIFIER_PREFIX=tenant
# KNOVAS_SHARE_UNC=\\fileserver\share
#
# Identity database. setup.sh generates secrets/platform_db_password (0600) and
# mounts it as a Docker secret; a file rather than a variable so the value does
# not appear in `docker inspect` or a support bundle. Override the names only if
# they clash with something else on the host.
# PLATFORM_DB_NAME=knovas_platform
# PLATFORM_DB_USER=platform
#
# Supply your own first-administrator password instead of a generated one. It
# goes through the same policy as everyone else's (at least 12 characters, no
# leading or trailing space), so the placeholders app.py:701 refuses are refused
# here too. Recommended: a generated password is written to
# PLATFORM_ADMIN_BOOTSTRAP_PATH, which defaults to /run inside the container and
# is gone the next time docbridge-web is recreated. Bootstrap only runs against a
# database with no accounts, so losing that file before reading it leaves an
# account whose password nobody knows and no way to reissue it short of dropping
# the identity volume.
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_BOOTSTRAP_PATH=/run/platform-admin-bootstrap

# Superseded by per-user accounts (Pflichtenheft B1). Left here only so an
# existing deployment can be read; the Platform refuses to start with these set
# once identity.enabled is true.
# COMPANY_LOGIN_NAME=
# COMPANY_LOGIN_PASSWORD=
